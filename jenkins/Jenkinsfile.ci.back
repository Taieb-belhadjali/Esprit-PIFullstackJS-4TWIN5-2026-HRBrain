pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Backend') {
            steps {
                dir('BackOffice') {
                    bat 'npm ci'
                }
            }
        }

        stage('Test Backend') {
            steps {
                dir('BackOffice') {
                    bat 'npm run test:cov -- --passWithNoTests --forceExit'
                }
            }
        }

        stage('Build Backend') {
            steps {
                dir('BackOffice') {
                    bat 'npm run build'
                }
            }
        }
    }

    post {
        always {
            echo 'Tests exécutés'
        }

        success {
            echo '✅ CI Backend réussi'
            build job: 'Jenkinsfile.cd.back', wait: false
        }

        failure {
            echo '❌ CI Backend échoué'
        }
    }
}
