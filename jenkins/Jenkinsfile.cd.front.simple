// ─────────────────────────────────────────────────────────────────
// HRBrain — CD Pipeline Frontend (Kubernetes)
// Déclenché automatiquement par CI Frontend
// ─────────────────────────────────────────────────────────────────

pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG',
               defaultValue: 'latest',
               description: 'Tag Docker à déployer (ex: 42)')
    }

    environment {
        DOCKER_IMAGE  = "mouadh08/hrbrain-frontend"
        K8S_NAMESPACE = 'hrbrain'
        K8S_DEPLOY    = 'frontend'
        IMAGE_TAG     = "${params.IMAGE_TAG ?: 'latest'}"
    }

    options {
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: '*/main']],
                    extensions: [
                        [$class: 'CloneOption', depth: 1, shallow: true, noTags: true, timeout: 60],
                        [$class: 'CheckoutOption', timeout: 60]
                    ],
                    userRemoteConfigs: scm.userRemoteConfigs
                ])
                echo "Deploying ${DOCKER_IMAGE}:${IMAGE_TAG} → ${K8S_NAMESPACE}/${K8S_DEPLOY}"
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh """
                        kubectl apply -f k8s/namespace.yaml
                        kubectl apply -f k8s/configmap.yaml
                        kubectl apply -f k8s/secret.yaml
                        kubectl apply -f k8s/frontend-deployment.yaml
                        kubectl apply -f k8s/frontend-service.yaml

                        kubectl set image deployment/${K8S_DEPLOY} \\
                          frontend=${DOCKER_IMAGE}:${IMAGE_TAG} \\
                          -n ${K8S_NAMESPACE}

                        kubectl rollout status deployment/${K8S_DEPLOY} \\
                          -n ${K8S_NAMESPACE} --timeout=300s
                    """
                }
            }
        }

        stage('Verify') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh """
                        kubectl get pods -n ${K8S_NAMESPACE} -l app=frontend
                        kubectl get svc  -n ${K8S_NAMESPACE}
                    """
                }
            }
        }

        stage('Smoke Test') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh """
                        sleep 5
                        curl -sf http://10.248.202.11:30080 || \\
                          (echo '❌ Smoke test Frontend échoué' && exit 1)
                        echo '✅ Smoke test Frontend réussi'
                    """
                }
            }
        }

    }

    post {
        success {
            echo "✅ CD Frontend #${env.BUILD_NUMBER} — ${DOCKER_IMAGE}:${IMAGE_TAG} déployé"
            emailext(
                subject: "✅ CD Frontend SUCCESS — Deploy #${env.BUILD_NUMBER}",
                body: """<h2>✅ Déploiement Frontend réussi</h2>
<p><b>Deploy:</b> #${env.BUILD_NUMBER}</p>
<p><b>Image:</b> ${DOCKER_IMAGE}:${IMAGE_TAG}</p>
<p><b>Namespace:</b> ${K8S_NAMESPACE}</p>
<p><b>App:</b> <a href="http://10.248.202.11:30080">http://10.248.202.11:30080</a></p>
<p><a href="${env.BUILD_URL}">Voir le build</a></p>""",
                mimeType: 'text/html',
                to: 'taiebaminebelhadjali@gmail.com'
            )
        }
        failure {
            echo "❌ CD Frontend #${env.BUILD_NUMBER} FAILED — Rollback en cours..."
            withKubeConfig([credentialsId: 'kubeconfig']) {
                sh "kubectl rollout undo deployment/${K8S_DEPLOY} -n ${K8S_NAMESPACE} || true"
            }
            emailext(
                subject: "❌ CD Frontend FAILURE — Deploy #${env.BUILD_NUMBER}",
                body: """<h2>❌ Déploiement Frontend échoué</h2>
<p><b>Deploy:</b> #${env.BUILD_NUMBER}</p>
<p><b>Image:</b> ${DOCKER_IMAGE}:${IMAGE_TAG}</p>
<p><b>Action:</b> Rollback automatique effectué</p>
<p><a href="${env.BUILD_URL}console">Voir les logs</a></p>""",
                mimeType: 'text/html',
                to: 'taiebaminebelhadjali@gmail.com'
            )
        }
        always {
            cleanWs()
        }
    }
}
