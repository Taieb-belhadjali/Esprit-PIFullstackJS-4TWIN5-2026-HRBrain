// ─────────────────────────────────────────────────────────────────
// HRBrain — CD Pipeline Backend (Kubernetes)
// Déclenché automatiquement par CI Backend
// ─────────────────────────────────────────────────────────────────

pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG',
               defaultValue: 'latest',
               description: 'Tag Docker à déployer (ex: 42)')
    }

    environment {
        DOCKER_IMAGE  = "mouadh08/hrbrain-backend"
        K8S_NAMESPACE = 'hrbrain'
        K8S_DEPLOY    = 'backend'
        IMAGE_TAG     = "${params.IMAGE_TAG ?: 'latest'}"
    }

    options {
        skipDefaultCheckout(true)
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    triggers {
        pollSCM('H/10 * * * *')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: '*/main']],
                    extensions: [
                        [$class: 'CloneOption', depth: 1, shallow: true, noTags: true, timeout: 60],
                        [$class: 'CheckoutOption', timeout: 60]
                    ],
                    userRemoteConfigs: scm.userRemoteConfigs
                ])
                echo "Deploying ${DOCKER_IMAGE}:${IMAGE_TAG} → ${K8S_NAMESPACE}/${K8S_DEPLOY}"
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh """
                        kubectl apply -f k8s/namespace.yaml
                        kubectl apply -f k8s/configmap.yaml
                        kubectl apply -f k8s/secret.yaml
                        kubectl apply -f k8s/backend-deployment.yaml
                        kubectl apply -f k8s/backend-service.yaml

                        kubectl set image deployment/${K8S_DEPLOY} \\
                          backend=${DOCKER_IMAGE}:${IMAGE_TAG} \\
                          -n ${K8S_NAMESPACE}

                        for i in \$(seq 1 30); do
                          READY=\$(kubectl get deployment/${K8S_DEPLOY} -n ${K8S_NAMESPACE} -o jsonpath='{.status.readyReplicas}' 2>/dev/null || echo 0)
                          DESIRED=\$(kubectl get deployment/${K8S_DEPLOY} -n ${K8S_NAMESPACE} -o jsonpath='{.spec.replicas}' 2>/dev/null || echo 1)
                          echo "Replicas: \${READY:-0}/\$DESIRED (attempt \$i/30)"
                          if [ "\${READY:-0}" = "\$DESIRED" ] && [ "\${READY:-0}" != "0" ]; then
                            echo "✅ Deployment ready"
                            break
                          fi
                          if [ \$i -eq 30 ]; then echo "❌ Timeout waiting for deployment" && exit 1; fi
                          sleep 10
                        done
                    """
                }
            }
        }

        stage('Verify') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh """
                        kubectl get pods -n ${K8S_NAMESPACE} -l app=backend
                        kubectl get svc  -n ${K8S_NAMESPACE}
                    """
                }
            }
        }

        stage('Smoke Test') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh """
                        sleep 5
                        curl -sf http://10.248.202.11:30000/health || \\
                          (echo '❌ Smoke test Backend échoué' && exit 1)
                        echo '✅ Smoke test Backend réussi'
                    """
                }
            }
        }

    }

    post {
        success {
            echo "✅ CD Backend #${env.BUILD_NUMBER} — ${DOCKER_IMAGE}:${IMAGE_TAG} déployé"
            emailext(
                subject: "✅ CD Backend SUCCESS — Deploy #${env.BUILD_NUMBER}",
                body: """<h2>✅ Déploiement Backend réussi</h2>
<p><b>Deploy:</b> #${env.BUILD_NUMBER}</p>
<p><b>Image:</b> ${DOCKER_IMAGE}:${IMAGE_TAG}</p>
<p><b>Namespace:</b> ${K8S_NAMESPACE}</p>
<p><b>Health:</b> <a href="http://10.248.202.11:30000/health">http://10.248.202.11:30000/health</a></p>
<p><a href="${env.BUILD_URL}">Voir le build</a></p>""",
                mimeType: 'text/html',
                to: 'taiebaminebelhadjali@gmail.com'
            )
        }
        failure {
            echo "❌ CD Backend #${env.BUILD_NUMBER} FAILED — Rollback en cours..."
            node('') {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl rollout undo deployment/${K8S_DEPLOY} -n ${K8S_NAMESPACE} || true"
                }
            }
            emailext(
                subject: "❌ CD Backend FAILURE — Deploy #${env.BUILD_NUMBER}",
                body: """<h2>❌ Déploiement Backend échoué</h2>
<p><b>Deploy:</b> #${env.BUILD_NUMBER}</p>
<p><b>Image:</b> ${DOCKER_IMAGE}:${IMAGE_TAG}</p>
<p><b>Action:</b> Rollback automatique effectué</p>
<p><a href="${env.BUILD_URL}console">Voir les logs</a></p>""",
                mimeType: 'text/html',
                to: 'taiebaminebelhadjali@gmail.com'
            )
        }
        always {
            cleanWs()
        }
    }
}
