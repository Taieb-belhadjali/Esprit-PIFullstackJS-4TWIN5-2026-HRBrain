pipeline {
    agent any

    environment {
        IMAGE_NAME = 'backoffice'
        CONTAINER_NAME = 'backoffice-app'
        PORT = '3000'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('BackOffice') {
                    bat "docker build -t %IMAGE_NAME%:latest ."
                }
            }
        }

        stage('Cleanup') {
            steps {
                bat 'docker stop %CONTAINER_NAME% 2>nul || exit /b 0'
                bat 'docker rm %CONTAINER_NAME% 2>nul || exit /b 0'
            }
        }

        stage('Run Backend') {
            steps {
                bat '''
                docker run -d ^
                -p %PORT%:3000 ^
                --name %CONTAINER_NAME% ^
                --restart unless-stopped ^
                %IMAGE_NAME%:latest
                '''
            }
        }

        stage('Health Check') {
            steps {
                bat '''
                timeout /t 5 >nul
                curl http://localhost:%PORT% || exit /b 1
                '''
            }
        }
    }

    post {
        success {
            echo '✅ CD Backend déployé et fonctionnel'
        }
        failure {
            bat 'docker stop %CONTAINER_NAME% 2>nul || exit /b 0'
            bat 'docker rm %CONTAINER_NAME% 2>nul || exit /b 0'
            echo '❌ CD Backend échoué'
        }
    }
}
