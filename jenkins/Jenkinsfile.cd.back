pipeline {
    agent any

    environment {
        IMAGE_NAME = 'backoffice'
        CONTAINER_NAME = 'backoffice-app'
        PORT = '3000'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('BackOffice') {
                    bat "docker build -t %IMAGE_NAME%:latest ."
                }
            }
        }

        stage('Deploy Backend') {
            steps {
                bat '''
                docker stop %CONTAINER_NAME% || exit 0
                docker rm %CONTAINER_NAME% || exit 0
                docker run -d -p %PORT%:3000 --name %CONTAINER_NAME% %IMAGE_NAME%:latest
                '''
            }
        }
    }

    post {
        success {
            echo '✅ CD Backend déployé'
        }
        failure {
            echo '❌ CD Backend échoué'
        }
    }
}
