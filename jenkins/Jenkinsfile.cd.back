pipeline {
    agent any

    environment {
        IMAGE_NAME = 'backoffice'
        CONTAINER_NAME = 'backoffice-app'
        PORT = '3000'
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build Image Docker') {
            steps {
                dir('BackOffice') {
                    sh "docker build -t ${IMAGE_NAME}:latest ."
                }
            }
        }
        stage('Deploy Backend') {
            steps {
                sh """
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true
                    docker run -d \
                        --name ${CONTAINER_NAME} \
                        -p ${PORT}:3000 \
                        --restart unless-stopped \
                        ${IMAGE_NAME}:latest
                """
            }
        }
    }
    post {
        success { echo '✅ CD Backend déployé' }
        failure { echo '❌ CD Backend échoué' }
    }
}
