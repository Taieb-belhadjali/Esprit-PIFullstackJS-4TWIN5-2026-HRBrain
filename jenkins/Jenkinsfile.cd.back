pipeline {
    agent any

    environment {
        IMAGE_NAME = 'backoffice'
        CONTAINER_NAME = 'backoffice-app'
        PORT = '3000'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('BackOffice') {
                    bat "docker build -t %IMAGE_NAME%:latest ."
                }
            }
        }

        stage('Cleanup Old Container') {
            steps {
                bat 'docker stop %CONTAINER_NAME% 2>nul & exit /b 0'
                bat 'docker rm %CONTAINER_NAME% 2>nul & exit /b 0'
            }
        }

        stage('Run Backend') {
            steps {
                bat '''
                docker run -d ^
                -p %PORT%:3000 ^
                --name %CONTAINER_NAME% ^
                --restart unless-stopped ^
                %IMAGE_NAME%:latest
                '''
            }
        }

        stage('Wait Backend Start') {
            steps {
                // attendre 10 secondes proprement
                sleep(time: 10, unit: 'SECONDS')
            }
        }

        stage('Health Check') {
            steps {
                bat '''
                docker ps | findstr %CONTAINER_NAME% || exit /b 1
                '''
            }
        }
    }

    post {
        success {
            echo '✅ CD Backend déployé avec succès et container actif'
        }

        failure {
            bat 'docker stop %CONTAINER_NAME% 2>nul & exit /b 0'
            bat 'docker rm %CONTAINER_NAME% 2>nul & exit /b 0'
            echo '❌ CD Backend échoué'
        }
    }
}
