pipeline {
    agent any
    environment {
        IMAGE_NAME = 'backoffice'
        CONTAINER_NAME = 'backoffice-app'
        PORT = '3000'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('BackOffice') {
                    bat "docker build -t %IMAGE_NAME%:latest ."
                }
            }
        }
        stage('Cleanup') {
            steps {
                bat 'docker stop %CONTAINER_NAME% 2>nul & exit /b 0'
                bat 'docker rm %CONTAINER_NAME% 2>nul & exit /b 0'
                bat 'docker container prune -f 2>nul & exit /b 0'
                bat '''
                for /f "tokens=5" %%a in ('netstat -ano ^| findstr /R ":%PORT% "') do (
                    taskkill /PID %%a /F 2>nul
                )
                exit /b 0
                '''
            }
        }
        stage('Run Backend') {
            steps {
                bat '''
                docker run -d ^
                -p %PORT%:3000 ^
                --name %CONTAINER_NAME% ^
                --restart unless-stopped ^
                %IMAGE_NAME%:latest
                '''
            }
        }
    }
    post {
        success {
            echo '✅ CD Backend déployé avec succès'
        }
        failure {
            bat 'docker stop %CONTAINER_NAME% 2>nul & exit /b 0'
            bat 'docker rm %CONTAINER_NAME% 2>nul & exit /b 0'
            echo '❌ CD Backend échoué'
        }
    }
}
