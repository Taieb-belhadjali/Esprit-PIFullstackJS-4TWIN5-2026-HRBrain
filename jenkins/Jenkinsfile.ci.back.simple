// ─────────────────────────────────────────────────────────────────
// HRBrain — CI Pipeline Backend (NestJS) - Version avec SonarQube
// ─────────────────────────────────────────────────────────────────

pipeline {
    agent any

    environment {
        APP_NAME       = 'hrbrain-backend'
        DOCKER_IMAGE   = "mouadh08/hrbrain-backend"
        DOCKER_TAG     = "${env.BUILD_NUMBER}"
        SONAR_PROJECT  = "hrbrain-backend"
        SONAR_URL      = "http://192.168.1.12:30900"
    }

    options {
        timeout(time: 40, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "✅ Branch: ${env.GIT_BRANCH} | Commit: ${env.GIT_COMMIT?.take(8)}"
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('BackOffice') {
                    sh 'npm ci'
                }
            }
        }

        stage('Lint') {
            steps {
                dir('BackOffice') {
                    sh 'npm run lint || true'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('BackOffice') {
                    sh 'npm run test:cov -- --forceExit || true'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'BackOffice/coverage/junit.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                    dir('BackOffice') {
                        sh """
                            npx sonar-scanner \
                              -Dsonar.projectKey=${SONAR_PROJECT} \
                              -Dsonar.projectName="HRBrain Backend" \
                              -Dsonar.sources=src \
                              -Dsonar.tests=src \
                              -Dsonar.test.inclusions=**/*.spec.ts \
                              -Dsonar.typescript.lcov.reportPaths=coverage/lcov.info \
                              -Dsonar.host.url=${SONAR_URL} \
                              -Dsonar.token=\${SONAR_TOKEN} \
                              -Dsonar.exclusions=**/node_modules/**,**/dist/**,**/*.spec.ts \
                              -Dsonar.coverage.exclusions=**/node_modules/**,**/dist/**,**/*.spec.ts,**/*.module.ts,**/*.schema.ts,**/*.dto.ts,**/dto*/**,**/scripts/**,**/main.ts,**/app.controller.ts,**/app.module.ts,**/load-env.ts,**/recommendation/**,**/users/users.service.ts,**/users/users.controller.ts,**/activity/activity.service.ts,**/activity/activity.controller.ts \
                              || true
                        """
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('BackOffice') {
                    sh 'npm run build'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('BackOffice') {
                    sh """
                        docker build \
                          --target production \
                          -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                          -t ${DOCKER_IMAGE}:latest \
                          .
                    """
                }
            }
        }

        stage('Docker Push') {
            when {
                expression {
                    return env.GIT_BRANCH ==~ /.*(main).*/
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        docker push ${DOCKER_IMAGE}:latest
                        docker logout
                    """
                }
            }
        }

    }

    post {
        success {
            echo "✅ Pipeline CI Backend terminé — Image: ${DOCKER_IMAGE}:${DOCKER_TAG}"
            // Déclencher automatiquement le CD Backend
            build job: 'hrbrain-cd-backend',
                  parameters: [string(name: 'IMAGE_TAG', value: "${DOCKER_TAG}")],
                  wait: false
            // Alerte email succès
            emailext(
                subject: "✅ CI Backend SUCCESS - Build #${env.BUILD_NUMBER}",
                body: """
                    <h2>✅ Pipeline CI Backend réussi</h2>
                    <p><b>Build:</b> #${env.BUILD_NUMBER}</p>
                    <p><b>Branch:</b> ${env.GIT_BRANCH}</p>
                    <p><b>Commit:</b> ${env.GIT_COMMIT?.take(8)}</p>
                    <p><b>Image Docker:</b> ${DOCKER_IMAGE}:${DOCKER_TAG}</p>
                    <p><b>CD Backend:</b> Déclenché automatiquement avec IMAGE_TAG=${DOCKER_TAG}</p>
                    <p><a href="${env.BUILD_URL}">Voir le build</a></p>
                """,
                mimeType: 'text/html',
                to: 'taiebaminebelhadjali@gmail.com'
            )
        }
        failure {
            echo "❌ Pipeline CI Backend échoué"
            // Alerte email échec
            emailext(
                subject: "❌ CI Backend FAILURE - Build #${env.BUILD_NUMBER}",
                body: """
                    <h2>❌ Pipeline CI Backend échoué</h2>
                    <p><b>Build:</b> #${env.BUILD_NUMBER}</p>
                    <p><b>Branch:</b> ${env.GIT_BRANCH}</p>
                    <p><b>Commit:</b> ${env.GIT_COMMIT?.take(8)}</p>
                    <p><b>Erreur:</b> Vérifier les logs du build</p>
                    <p><a href="${env.BUILD_URL}console">Voir les logs</a></p>
                """,
                mimeType: 'text/html',
                to: 'taiebaminebelhadjali@gmail.com'
            )
        }
        always {
            sh "docker rmi ${DOCKER_IMAGE}:${DOCKER_TAG} || true"
            cleanWs()
        }
    }
}
