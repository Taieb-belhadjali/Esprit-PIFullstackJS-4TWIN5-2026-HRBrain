pipeline {
    agent any

    environment {
        IMAGE_NAME = 'frontoffice'
        CONTAINER_NAME = 'frontoffice-app'
        PORT = '80'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Image Docker') {
            steps {
                dir('FrontOffice') {
                    bat "docker build -t %IMAGE_NAME%:latest ."
                }
            }
        }

        stage('Deploy Frontend') {
            steps {
                bat '''
                docker stop %CONTAINER_NAME% || exit 0
                docker rm %CONTAINER_NAME% || exit 0
                docker run -d -p %PORT%:80 --name %CONTAINER_NAME% %IMAGE_NAME%:latest
                '''
            }
        }
    }

    post {
        success {
            echo '✅ CD Frontend déployé'
        }
        failure {
            echo '❌ CD Frontend échoué'
        }
    }
}
