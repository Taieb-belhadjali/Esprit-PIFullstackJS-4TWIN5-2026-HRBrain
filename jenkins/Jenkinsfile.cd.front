// ─────────────────────────────────────────────────────────────────
// HRBrain — CD Pipeline Frontend (déploiement Kubernetes)
// Trigger : après succès du CI Frontend sur main
//
// ⚠️  GARDE : vérifie que le CI Backend est aussi en succès avant
//     de déployer — évite un état incohérent front OK / back cassé
// ─────────────────────────────────────────────────────────────────

pipeline {
    agent any

    environment {
        APP_NAME      = 'hrbrain-frontend'
        DOCKER_IMAGE  = "mouadh08/hrbrain-frontend"
        K8S_NAMESPACE = 'hrbrain'
        K8S_DEPLOY    = 'frontend'
        IMAGE_TAG     = "${params.IMAGE_TAG ?: 'latest'}"
        // Nom exact du job CI Backend dans Jenkins
        BACKEND_CI_JOB = 'hrbrain-ci-backend'
    }

    parameters {
        string(name: 'IMAGE_TAG',
               defaultValue: 'latest',
               description: 'Tag de l\'image Docker à déployer (ex: 42)')
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {

        // ── 1. Checkout ──────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ── 2. Garde — CI Backend doit être en succès ─────────────
        // Si le backend est cassé, on bloque le déploiement frontend
        // pour éviter un état incohérent (front déployé, back KO)
        stage('Check Backend CI Status') {
            steps {
                script {
                    def backendJob = Jenkins.instance.getItemByFullName(env.BACKEND_CI_JOB)

                    if (backendJob == null) {
                        error("❌ Job CI Backend '${env.BACKEND_CI_JOB}' introuvable dans Jenkins")
                    }

                    def lastBuild = backendJob.getLastBuild()
                    if (lastBuild == null) {
                        error("❌ Aucun build trouvé pour le CI Backend — déploiement bloqué")
                    }

                    def result = lastBuild.getResult()?.toString()
                    echo "📋 Dernier build CI Backend : #${lastBuild.number} → ${result}"

                    if (result != 'SUCCESS') {
                        error("❌ CI Backend en état '${result}' — déploiement Frontend bloqué. Corrige le backend d'abord.")
                    }

                    echo "✅ CI Backend OK — déploiement Frontend autorisé"
                }
            }
        }

        // ── 3. Vérification image Docker ─────────────────────────
        stage('Verify Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker pull ${DOCKER_IMAGE}:${IMAGE_TAG}
                        docker logout
                    """
                }
            }
        }

        // ── 4. Déploiement Kubernetes ────────────────────────────
        stage('Deploy to Kubernetes') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh """
                        # Appliquer les manifests
                        kubectl apply -f k8s/namespace.yaml
                        kubectl apply -f k8s/frontend-deployment.yaml
                        kubectl apply -f k8s/frontend-service.yaml

                        # Mettre à jour l'image
                        kubectl set image deployment/${K8S_DEPLOY} \
                          frontend=${DOCKER_IMAGE}:${IMAGE_TAG} \
                          -n ${K8S_NAMESPACE}

                        # Attendre le rollout
                        kubectl rollout status deployment/${K8S_DEPLOY} \
                          -n ${K8S_NAMESPACE} \
                          --timeout=300s
                    """
                }
            }
        }

        // ── 5. Vérification post-déploiement ─────────────────────
        stage('Verify Deployment') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh """
                        echo "=== Pods Frontend ==="
                        kubectl get pods -n ${K8S_NAMESPACE} -l app=frontend

                        echo "=== Services ==="
                        kubectl get svc -n ${K8S_NAMESPACE}
                    """
                }
            }
        }

        // ── 6. Smoke Test ────────────────────────────────────────
        stage('Smoke Test') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    script {
                        def nodeIp = sh(
                            script: "kubectl get nodes -o jsonpath='{.items[0].status.addresses[?(@.type==\"InternalIP\")].address}'",
                            returnStdout: true
                        ).trim()

                        sh """
                            sleep 10
                            curl -f http://${nodeIp}:30080 || \
                              (echo '❌ Smoke test Frontend échoué' && exit 1)
                            echo '✅ Smoke test Frontend réussi'
                        """
                    }
                }
            }
        }

    }

    post {
        success {
            echo "✅ Déploiement Frontend réussi — Image: ${DOCKER_IMAGE}:${IMAGE_TAG}"
        }
        failure {
            echo "❌ Déploiement Frontend échoué — Rollback en cours..."
            withKubeConfig([credentialsId: 'kubeconfig']) {
                sh "kubectl rollout undo deployment/${K8S_DEPLOY} -n ${K8S_NAMESPACE} || true"
            }
        }
        always {
            cleanWs()
        }
    }
}
