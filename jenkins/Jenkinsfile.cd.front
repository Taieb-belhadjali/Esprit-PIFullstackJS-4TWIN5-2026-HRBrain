pipeline {
    agent any

    environment {
        IMAGE_NAME = 'frontoffice'
        CONTAINER_NAME = 'frontoffice-app'
        PORT = '5173'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('FrontOffice') {
                    bat "docker build -t %IMAGE_NAME%:latest ."
                }
            }
        }

        stage('Stop Old Container') {
            steps {
                bat '''
                docker stop %CONTAINER_NAME% || exit /b 0
                docker rm %CONTAINER_NAME% || exit /b 0
                '''
            }
        }

        stage('Run Container') {
            steps {
                bat '''
                docker run -d ^
                -p %PORT%:80 ^
                --name %CONTAINER_NAME% ^
                %IMAGE_NAME%:latest
                '''
            }
        }
    }

    post {
        success {
            echo '✅ CD Frontend déployé avec succès'
        }
        failure {
            echo '❌ CD Frontend échoué'
        }
    }
}
