// ─────────────────────────────────────────────────────────────────
// HRBrain — CI Pipeline Frontend (React/Vite)
// Durée cible : ~8 min
// ─────────────────────────────────────────────────────────────────

pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "mouadh08/hrbrain-frontend"
        DOCKER_TAG   = "${env.BUILD_NUMBER}"
        SONAR_URL    = "http://192.168.1.12:30900"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Branch: ${env.GIT_BRANCH} | Commit: ${env.GIT_COMMIT?.take(8)}"
            }
        }

        stage('Install') {
            steps {
                dir('FrontOffice') {
                    sh 'npm ci --prefer-offline 2>/dev/null || npm ci'
                }
            }
        }

        stage('Lint & Tests') {
            parallel {
                stage('Lint') {
                    steps {
                        dir('FrontOffice') {
                            sh 'node_modules/typescript/bin/tsc --noEmit || true'
                        }
                    }
                }
                stage('Unit Tests') {
                    steps {
                        dir('FrontOffice') {
                            sh 'npm run test:coverage -- --reporter=verbose || true'
                        }
                    }
                }
            }
        }

        stage('SonarQube') {
            steps {
                withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                    dir('FrontOffice') {
                        sh """
                            npx sonar-scanner \
                              -Dsonar.projectKey=hrbrain-frontend \
                              -Dsonar.projectName="HRBrain Frontend" \
                              -Dsonar.sources=src \
                              -Dsonar.tests=src \
                              -Dsonar.test.inclusions=**/*.test.ts,**/*.test.tsx \
                              -Dsonar.typescript.lcov.reportPaths=coverage/lcov.info \
                              -Dsonar.host.url=${SONAR_URL} \
                              -Dsonar.token=\${SONAR_TOKEN} \
                              -Dsonar.exclusions=**/node_modules/**,**/dist/**,**/*.test.tsx,**/*.test.ts \
                              || true
                        """
                    }
                }
            }
        }

        stage('Build & Docker') {
            stages {
                stage('Build Vite') {
                    steps {
                        dir('FrontOffice') {
                            sh 'NODE_OPTIONS="--max-old-space-size=1024" npm run build'
                        }
                    }
                }

                stage('Docker Build') {
                    steps {
                        dir('FrontOffice') {
                            sh """
                                docker build \
                                  --target production \
                                  --build-arg ENV=k8s \
                                  -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                                  -t ${DOCKER_IMAGE}:latest \
                                  .
                            """
                        }
                    }
                }

                stage('Docker Push') {
                    when {
                        branch 'main'
                    }
                    steps {
                        withCredentials([usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )]) {
                            sh """
                                echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                                docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                                docker push ${DOCKER_IMAGE}:latest
                                docker logout
                            """
                        }
                    }
                }
            }
        }

    }

    post {
        success {
            echo "✅ CI Frontend #${env.BUILD_NUMBER} — Image: ${DOCKER_IMAGE}:${DOCKER_TAG}"
            build job: 'hrbrain-cd-frontend',
                  parameters: [string(name: 'IMAGE_TAG', value: "${DOCKER_TAG}")],
                  wait: false
        }
        unstable {
            echo "⚠️ CI Frontend #${env.BUILD_NUMBER} UNSTABLE — déploiement déclenché quand même"
            build job: 'hrbrain-cd-frontend',
                  parameters: [string(name: 'IMAGE_TAG', value: "${DOCKER_TAG}")],
                  wait: false
        }
        failure {
            echo "❌ CI Frontend #${env.BUILD_NUMBER} FAILED — CD non déclenché"
        }
        always {
            sh "docker rmi ${DOCKER_IMAGE}:${DOCKER_TAG} || true"
            cleanWs()
        }
    }
}
