// ─────────────────────────────────────────────────────────────────
// HRBrain — CI Pipeline Frontend (React/Vite) - Version avec SonarQube
// ─────────────────────────────────────────────────────────────────

pipeline {
    agent any

    environment {
        APP_NAME       = 'hrbrain-frontend'
        DOCKER_IMAGE   = "mouadh08/hrbrain-frontend"
        DOCKER_TAG     = "${env.BUILD_NUMBER}"
        SONAR_PROJECT  = "hrbrain-frontend"
        SONAR_URL      = "http://sonarqube-service:9000"
    }

    options {
        timeout(time: 40, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "✅ Branch: ${env.GIT_BRANCH} | Commit: ${env.GIT_COMMIT?.take(8)}"
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('FrontOffice') {
                    sh 'npm ci'
                }
            }
        }

        stage('Lint') {
            steps {
                dir('FrontOffice') {
                    sh 'node_modules/typescript/bin/tsc --noEmit || true'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('FrontOffice') {
                    sh 'npm run test -- --run --coverage --reporter=junit --outputFile=coverage/junit.xml || true'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'FrontOffice/coverage/junit.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                    dir('FrontOffice') {
                        sh """
                            npx sonar-scanner \
                              -Dsonar.projectKey=${SONAR_PROJECT} \
                              -Dsonar.projectName="HRBrain Frontend" \
                              -Dsonar.sources=src \
                              -Dsonar.typescript.lcov.reportPaths=coverage/lcov.info \
                              -Dsonar.host.url=${SONAR_URL} \
                              -Dsonar.token=\${SONAR_TOKEN} \
                              -Dsonar.exclusions=**/node_modules/**,**/dist/**,**/*.test.tsx \
                              || true
                        """
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('FrontOffice') {
                    sh 'NODE_OPTIONS="--max-old-space-size=1024" npm run build'
                }
            }
            post {
                success {
                    echo "✅ Build Vite réussi"
                    archiveArtifacts artifacts: 'FrontOffice/dist/**/*',
                                     allowEmptyArchive: false
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('FrontOffice') {
                    sh """
                        docker build \
                          --target production \
                          --build-arg ENV=k8s \
                          -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                          -t ${DOCKER_IMAGE}:latest \
                          .
                    """
                }
            }
        }

        stage('Docker Push') {
            when {
                expression {
                    return env.GIT_BRANCH ==~ /.*(main).*/
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        docker push ${DOCKER_IMAGE}:latest
                        docker logout
                    """
                }
            }
        }

    }

    post {
        success {
            echo "✅ Pipeline CI Frontend terminé — Image: ${DOCKER_IMAGE}:${DOCKER_TAG}"
        }
        failure {
            echo "❌ Pipeline CI Frontend échoué"
        }
        always {
            sh "docker rmi ${DOCKER_IMAGE}:${DOCKER_TAG} || true"
            cleanWs()
        }
    }
}
