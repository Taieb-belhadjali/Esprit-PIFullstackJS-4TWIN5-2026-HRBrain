pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Frontend') {
            steps {
                dir('FrontOffice') {
                    bat 'npm ci'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('FrontOffice') {
                    bat 'npm run build'
                }
            }
        }
    }

    post {
        success {
            echo '✅ CI Frontend réussi'
            build job: 'Jenkinsfile.cd.front', wait: false
        }

        failure {
            echo '❌ CI Frontend échoué'
        }
    }
}
