// ─────────────────────────────────────────────────────────────────
// HRBrain — CI Pipeline Frontend (React/Vite)
// Trigger : push sur main ou develop
// ─────────────────────────────────────────────────────────────────

pipeline {
    agent any

    environment {
        NODE_VERSION   = '18'
        APP_NAME       = 'hrbrain-frontend'
        DOCKER_IMAGE   = "mouadh08/hrbrain-frontend"
        DOCKER_TAG     = "${env.BUILD_NUMBER}"
        SONAR_PROJECT  = 'hrbrain-frontend'
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    triggers {
        githubPush()
    }

    stages {

        // ── 1. Checkout ──────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
                echo "✅ Branch: ${env.GIT_BRANCH} | Commit: ${env.GIT_COMMIT?.take(8)}"
            }
        }

        // ── 2. Install Dependencies ──────────────────────────────
        stage('Install Dependencies') {
            steps {
                dir('FrontOffice') {
                    sh 'npm ci'
                }
            }
        }

        // ── 3. Lint ──────────────────────────────────────────────
        stage('Lint') {
            steps {
                dir('FrontOffice') {
                    // Vite/React project — vérification TypeScript
                    sh 'npx tsc --noEmit || true'
                }
            }
        }

        // ── 4. Build ─────────────────────────────────────────────
        stage('Build') {
            steps {
                dir('FrontOffice') {
                    sh 'npm run build'
                }
            }
            post {
                success {
                    echo "✅ Build Vite réussi"
                    // Archiver les artefacts de build
                    archiveArtifacts artifacts: 'FrontOffice/dist/**/*',
                                     allowEmptyArchive: false
                }
            }
        }

        // ── 5. SonarQube Analysis ────────────────────────────────
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir('FrontOffice') {
                        sh """
                            npx sonar-scanner \
                              -Dsonar.projectKey=${SONAR_PROJECT} \
                              -Dsonar.projectName='HRBrain Frontend' \
                              -Dsonar.sources=src \
                              -Dsonar.exclusions=**/node_modules/**,**/dist/**,**/*.test.tsx \
                              -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                              -Dsonar.typescript.tsconfigPath=tsconfig.json
                        """
                    }
                }
            }
        }

        // ── 6. Quality Gate ──────────────────────────────────────
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ── 7. Docker Build ──────────────────────────────────────
        stage('Docker Build') {
            steps {
                dir('FrontOffice') {
                    // --build-arg ENV=k8s → nginx utilise backend-service (nom Service K8s)
                    sh """
                        docker build \
                          --target production \
                          --build-arg ENV=k8s \
                          -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                          -t ${DOCKER_IMAGE}:latest \
                          .
                    """
                }
            }
        }

        // ── 8. Docker Push ───────────────────────────────────────
        stage('Docker Push') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        docker push ${DOCKER_IMAGE}:latest
                        docker logout
                    """
                }
            }
        }

    }

    post {
        success {
            echo "✅ Pipeline CI Frontend terminé avec succès — Image: ${DOCKER_IMAGE}:${DOCKER_TAG}"
        }
        failure {
            echo "❌ Pipeline CI Frontend échoué"
        }
        always {
            sh "docker rmi ${DOCKER_IMAGE}:${DOCKER_TAG} || true"
            cleanWs()
        }
    }
}
