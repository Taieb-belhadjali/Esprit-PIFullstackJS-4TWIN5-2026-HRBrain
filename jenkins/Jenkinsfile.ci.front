pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Frontend') {
            steps {
                dir('FrontOffice') {
                    bat 'npm install'
                }
            }
        }

        stage('Test Frontend') {
            steps {
                dir('FrontOffice') {
                    bat 'npm test -- --watchAll=false || exit 0'
                }
            }
        }

        stage('Build Frontend (Vite)') {
            steps {
                dir('FrontOffice') {
                    bat 'npm run build'
                }
            }
        }

        stage('Verify Dist') {
            steps {
                dir('FrontOffice') {
                    bat 'dir dist'
                }
            }
        }
    }

    post {
        success {
            echo '✅ CI React + Vite réussi'
        }

        failure {
            echo '❌ CI Frontend échoué'
        }
    }
}
