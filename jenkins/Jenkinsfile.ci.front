pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    environment {
        SONAR_HOST_URL = 'http://localhost:9000'
        SONAR_TOKEN = credentials('sonar-token')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('FrontOffice') {
                    bat 'npm ci'
                }
            }
        }

        stage('Test') {
            steps {
                dir('FrontOffice') {
                    bat 'npm test -- --watchAll=false || exit 0'
                }
            }
        }

       stage('SonarQube Analysis') {
    steps {
        dir('FrontOffice') {
            withSonarQubeEnv('SonarQube') {
                bat """
                sonar-scanner ^
                -Dsonar.projectKey=zeroone-studio-frontend ^
                -Dsonar.sources=src ^
                -Dsonar.host.url=http://localhost:9000 ^
                -Dsonar.token=%SONAR_TOKEN%
                """
            }
        }
    }
}

        stage('Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('FrontOffice') {
                    bat 'npm run build'
                }
            }
        }
    }

    post {
        success {
            echo '✅ CI Frontend OK + SonarQube OK'
        }
        failure {
            echo '❌ CI Frontend échoué'
        }
    }
}
